{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-website-cloner-template",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
